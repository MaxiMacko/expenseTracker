# Application
NODE_ENV=production
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_DB=expense_tracker
DATABASE_URL=postgresql://postgres:replace-with-a-database-password@db:5432/expense_tracker

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-pgadmin-password

# PostgreSQL container initialization
POSTGRES_INITDB_ARGS=-c log_statement=all -c log_duration=on
